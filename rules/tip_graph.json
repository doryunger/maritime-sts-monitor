{
  "nodes": {
    "snapshot": { "kind": "source", "interval_min": 60, "basis": "decision" },
    "external_report": { "kind": "source", "providers": ["UKMTO", "JMIC"], "basis": "decision" },

    "vessel_id": { "kind": "attribute", "source": "snapshot" },
    "position": { "kind": "attribute", "source": "snapshot" },
    "report_age_min": { "kind": "attribute", "source": "snapshot" },
    "speed_kn": { "kind": "attribute", "source": "snapshot" },
    "course_deg": { "kind": "attribute", "source": "snapshot" },
    "heading_deg": { "kind": "attribute", "source": "snapshot" },
    "rate_of_turn": { "kind": "attribute", "source": "snapshot" },
    "destination": { "kind": "attribute", "source": "snapshot" },
    "name": { "kind": "attribute", "source": "snapshot" },
    "flag": { "kind": "attribute", "source": "snapshot" },
    "length_m": { "kind": "attribute", "source": "snapshot" },
    "zone": { "kind": "attribute", "source": "map", "values": ["open_water", "port", "anchorage", "land"] },

    "stale_position": { "kind": "rule", "layer": "A" },
    "threat_signalling": { "kind": "rule", "layer": "A" },
    "stopped_at_sea": { "kind": "rule", "layer": "A" },
    "implausible_data": { "kind": "rule", "layer": "A" },
    "heading_course_mismatch": { "kind": "rule", "layer": "A" },
    "going_dark": { "kind": "rule", "layer": "B" },
    "back_on": { "kind": "rule", "layer": "B" },
    "appeared_from_nowhere": { "kind": "rule", "layer": "B" },
    "identity_change": { "kind": "rule", "layer": "B" },
    "destination_change": { "kind": "rule", "layer": "B" },
    "position_jump": { "kind": "rule", "layer": "B" },
    "mass_displacement": { "kind": "rule", "layer": "B" },
    "behaviour_change": { "kind": "rule", "layer": "B" },
    "loitering": { "kind": "rule", "layer": "B" },
    "ship_to_ship": { "kind": "rule", "layer": "pairs" },
    "shadowing": { "kind": "rule", "layer": "pairs" },
    "report_match": { "kind": "rule", "layer": "D", "search_radius_km": null, "basis": "tbd" },

    "repeat_offender": { "kind": "modifier", "layer": "C", "window_days": 30, "basis": "guess" },
    "nearby_alerts": { "kind": "modifier", "layer": "C", "radius_km": 20, "window_hours": 6, "basis": "guess" },

    "focus_watch": { "kind": "watch", "box_km": 50, "interval_min": 15, "grow_at_last_speed": true, "max_hours": null, "basis": { "box_km": "guess", "interval_min": "guess", "max_hours": "tbd" } },
    "incident": { "kind": "incident", "promote_min_score": 1.0, "basis": "guess" },
    "tip": { "kind": "output" }
  },
  "edges": [
    { "relation": "condition", "from": "stale_position", "to": "report_age_min", "op": ">", "relative_to": "own_history", "factor": null, "basis": "tbd" },
    { "relation": "condition", "from": "stale_position", "to": "speed_kn", "op": ">=", "value": 2, "unit": "kn", "basis": "guess" },
    { "relation": "condition", "from": "threat_signalling", "to": "destination", "op": "contains_any", "value": ["GUARD", "CHINESE CREW", "CNOWNER", "CREW&OWNER", "OWNER&CREW", "NO CONTACT"], "basis": "observed" },
    { "relation": "condition", "from": "stopped_at_sea", "to": "speed_kn", "op": "<", "value": 1, "unit": "kn", "basis": "guess" },
    { "relation": "condition", "from": "stopped_at_sea", "to": "zone", "op": "==", "value": "open_water" },
    { "relation": "condition", "from": "implausible_data", "to": "speed_kn", "op": ">", "value": 30, "unit": "kn", "basis": "guess" },
    { "relation": "condition", "from": "implausible_data", "to": "zone", "op": "==", "value": "land" },
    { "relation": "condition", "from": "implausible_data", "to": "rate_of_turn", "op": "outside", "value": [-127, 127], "basis": "ais_spec" },
    { "relation": "condition", "from": "implausible_data", "to": "length_m", "op": "outside", "value": [1, 500], "unit": "m", "basis": "guess" },
    { "relation": "condition", "from": "heading_course_mismatch", "to": "heading_deg", "op": "diff_from", "other": "course_deg", "value": null, "unit": "deg", "basis": "tbd" },
    { "relation": "condition", "from": "heading_course_mismatch", "to": "speed_kn", "op": ">=", "value": 3, "unit": "kn", "basis": "guess" },
    { "relation": "condition", "from": "going_dark", "to": "report_age_min", "op": "growing", "min_silent_hours": 2, "basis": "guess" },
    { "relation": "condition", "from": "going_dark", "to": "speed_kn", "op": ">=", "value": 2, "unit": "kn", "at": "last_report", "basis": "guess" },
    { "relation": "condition", "from": "going_dark", "to": "position", "op": "not_explained_by", "value": ["area_exit", "port_arrival"] },
    { "relation": "condition", "from": "back_on", "to": "report_age_min", "op": "reset_after", "min_gap_hours": null, "basis": "tbd" },
    { "relation": "condition", "from": "appeared_from_nowhere", "to": "vessel_id", "op": "new", "zone_not": ["area_edge", "port"] },
    { "relation": "condition", "from": "identity_change", "to": "name", "op": "changed" },
    { "relation": "condition", "from": "identity_change", "to": "flag", "op": "changed" },
    { "relation": "condition", "from": "identity_change", "to": "length_m", "op": "changed", "min_delta": 10, "unit": "m", "basis": "guess" },
    { "relation": "condition", "from": "destination_change", "to": "destination", "op": "changed" },
    { "relation": "condition", "from": "position_jump", "to": "position", "op": "implied_speed_above", "value": 30, "unit": "kn", "basis": "guess" },
    { "relation": "condition", "from": "mass_displacement", "to": "position", "op": "shared_shift", "min_vessels": null, "min_km": null, "basis": "tbd" },
    { "relation": "condition", "from": "behaviour_change", "to": "speed_kn", "op": "delta_above", "value": null, "unit": "kn", "basis": "tbd" },
    { "relation": "condition", "from": "behaviour_change", "to": "course_deg", "op": "delta_above", "value": null, "unit": "deg", "basis": "tbd" },
    { "relation": "condition", "from": "loitering", "to": "position", "op": "within_radius_for", "radius_km": null, "hours": null, "zone": "open_water", "basis": "tbd" },
    { "relation": "condition", "from": "ship_to_ship", "to": "position", "op": "pair_within", "value": 0.5, "unit": "km", "min_hours": 2, "basis": "guess" },
    { "relation": "condition", "from": "ship_to_ship", "to": "speed_kn", "op": "<", "value": 2, "unit": "kn", "both": true, "basis": "guess" },
    { "relation": "condition", "from": "shadowing", "to": "position", "op": "anonymous_track_follows", "max_km": null, "min_hours": null, "basis": "tbd" },

    { "relation": "raises", "from": "stale_position", "to": "incident", "weight": null },
    { "relation": "raises", "from": "threat_signalling", "to": "incident", "weight": null },
    { "relation": "raises", "from": "stopped_at_sea", "to": "incident", "weight": null },
    { "relation": "raises", "from": "implausible_data", "to": "incident", "weight": null },
    { "relation": "raises", "from": "heading_course_mismatch", "to": "incident", "weight": null },
    { "relation": "raises", "from": "going_dark", "to": "incident", "weight": null },
    { "relation": "raises", "from": "back_on", "to": "incident", "weight": null },
    { "relation": "raises", "from": "appeared_from_nowhere", "to": "incident", "weight": null },
    { "relation": "raises", "from": "identity_change", "to": "incident", "weight": null },
    { "relation": "raises", "from": "destination_change", "to": "incident", "weight": null },
    { "relation": "raises", "from": "position_jump", "to": "incident", "weight": null },
    { "relation": "raises", "from": "mass_displacement", "to": "incident", "weight": null },
    { "relation": "raises", "from": "behaviour_change", "to": "incident", "weight": null },
    { "relation": "raises", "from": "loitering", "to": "incident", "weight": null },
    { "relation": "raises", "from": "ship_to_ship", "to": "incident", "weight": null },
    { "relation": "raises", "from": "shadowing", "to": "incident", "weight": null },
    { "relation": "raises", "from": "external_report", "to": "incident", "direct": true },
    { "relation": "raises", "from": "report_match", "to": "incident", "weight": null },

    { "relation": "boosts", "from": "repeat_offender", "to": "incident", "boost": null },
    { "relation": "boosts", "from": "nearby_alerts", "to": "incident", "boost": null },

    { "relation": "opens", "from": "going_dark", "to": "focus_watch" },
    { "relation": "opens", "from": "stopped_at_sea", "to": "focus_watch" },
    { "relation": "opens", "from": "ship_to_ship", "to": "focus_watch" },
    { "relation": "feeds", "from": "focus_watch", "to": "snapshot" },

    { "relation": "promotes", "from": "incident", "to": "tip" }
  ]
}
