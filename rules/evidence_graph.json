{
  "nodes": {
    "tip": { "kind": "input" },

    "time_window": { "kind": "step", "before_hours": 6, "after_hours": 24, "tip_can_override": true, "basis": "decision" },
    "search_area": { "kind": "step", "min_radius_km": 5, "max_radius_km": 60, "radius": "last_speed * hours_to_capture + uncertainty_km", "basis": "decision" },
    "scene_search": { "kind": "step", "catalogs": ["earth-search", "planetary-computer"] },
    "detect": { "kind": "step" },
    "clean": { "kind": "step", "drop_on_land": true, "merge_within_m": 150, "basis": "guess" },
    "match_context": { "kind": "step", "max_distance_km": 1.0, "basis": "stage0" },
    "match_subject": { "kind": "step", "max_distance_km": 1.0, "basis": "stage0" },

    "sentinel2": { "kind": "sensor", "role": "optical", "product": "L1C", "pixel_m": 10, "max_cloud_pct": 30, "length_tolerance_m": null, "basis": { "max_cloud_pct": "decision", "length_tolerance_m": "tbd" } },
    "landsat": { "kind": "sensor", "role": "optical", "product": "L1", "pixel_m": 15, "max_cloud_pct": 30, "length_tolerance_m": null, "basis": { "max_cloud_pct": "decision", "length_tolerance_m": "tbd" } },
    "sentinel1": { "kind": "sensor", "role": "radar", "product": "GRD IW", "pixel_m": 10, "min_score": 0.7, "length_tolerance_m": null, "basis": { "min_score": "model", "length_tolerance_m": "tbd" } },
    "s1_reference_image": { "kind": "reference", "orbit_direction": "same_as_capture", "min_days_before": 30, "max_days_before": 90, "max_matches": 1, "basis": "model" },

    "stationary": { "kind": "state", "max_speed_kn": 1.0, "nav_states": ["at_anchor", "loitering", "alongside"], "basis": "guess" },
    "moving": { "kind": "state" },

    "no_capture": { "kind": "outcome" },
    "nothing_found": { "kind": "outcome" },
    "failed": { "kind": "outcome" },

    "confirmed": { "kind": "grade", "rank": 1 },
    "sar_only": { "kind": "grade", "rank": 2 },
    "optical_only": { "kind": "grade", "rank": 3 },
    "none": { "kind": "grade", "rank": 4 }
  },
  "edges": [
    { "relation": "feeds", "from": "tip", "to": "time_window" },
    { "relation": "feeds", "from": "time_window", "to": "scene_search" },
    { "relation": "feeds", "from": "scene_search", "to": "search_area", "when": "captures > 0" },
    { "relation": "feeds", "from": "scene_search", "to": "no_capture", "when": "captures == 0" },
    { "relation": "feeds", "from": "search_area", "to": "detect" },
    { "relation": "feeds", "from": "s1_reference_image", "to": "detect", "sensor": "sentinel1" },
    { "relation": "feeds", "from": "detect", "to": "clean" },
    { "relation": "feeds", "from": "clean", "to": "match_context" },
    { "relation": "feeds", "from": "match_context", "to": "match_subject" },
    { "relation": "feeds", "from": "match_subject", "to": "nothing_found", "when": "no match in any capture" },
    { "relation": "feeds", "from": "detect", "to": "failed", "when": "error" },

    { "relation": "classifies", "from": "tip", "to": "stationary", "when": "subject last speed <= stationary.max_speed_kn" },
    { "relation": "classifies", "from": "tip", "to": "moving", "when": "otherwise" },

    { "relation": "searches", "from": "scene_search", "to": "sentinel2" },
    { "relation": "searches", "from": "scene_search", "to": "landsat" },
    { "relation": "searches", "from": "scene_search", "to": "sentinel1" },

    { "relation": "pairs", "from": "sentinel2", "to": "sentinel1", "state": "moving", "max_gap_hours": "match_subject.max_distance_km / speed", "max_length_diff_m": 30, "basis": { "max_gap_hours": "decision", "max_length_diff_m": "stage0" } },
    { "relation": "pairs", "from": "landsat", "to": "sentinel1", "state": "moving", "max_gap_hours": "match_subject.max_distance_km / speed", "max_length_diff_m": 30, "basis": { "max_gap_hours": "decision", "max_length_diff_m": "stage0" } },
    { "relation": "pairs", "from": "sentinel2", "to": "sentinel1", "state": "stationary", "max_gap_hours": 30, "max_length_diff_m": 30, "basis": "stage0" },
    { "relation": "pairs", "from": "landsat", "to": "sentinel1", "state": "stationary", "max_gap_hours": 30, "max_length_diff_m": 30, "basis": "stage0" },

    { "relation": "grants", "from": "match_subject", "to": "confirmed", "requires": ["optical_match", "radar_match", "paired", "position_and_length_agree"] },
    { "relation": "grants", "from": "match_subject", "to": "sar_only", "requires": ["radar_match"], "excludes": ["optical_match"] },
    { "relation": "grants", "from": "match_subject", "to": "optical_only", "requires": ["optical_match"], "excludes": ["confirmed"] },
    { "relation": "grants", "from": "match_subject", "to": "none", "excludes": ["optical_match", "radar_match"] }
  ]
}
