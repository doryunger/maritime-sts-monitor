AWS_REGION=replace-with-region
S3_BUCKET_NAME=replace-with-bucket
STS_REDIS_URL=redis://sts:replace-with-password@replace-with-private-host:6379/0
STS_DATABASE_URL=postgresql://replace-with-user:replace-with-password@replace-with-private-host:5432/sts?sslmode=verify-full&sslrootcert=/app/data/secrets/sts_pg_server.crt
GIZMOSQL_URI=replace-with-private-flight-sql-uri
GIZMOSQL_USER=gizmosql_user
GIZMOSQL_PASSWORD=replace-with-password
EQUASIS_EMAIL=
EQUASIS_PASSWORD=
