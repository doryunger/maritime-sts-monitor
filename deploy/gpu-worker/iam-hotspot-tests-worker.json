{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteHotspotTestResults",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::<S3_BUCKET_NAME>/hotspot-tests/artifacts/*",
        "arn:aws:s3:::<S3_BUCKET_NAME>/hotspot-tests/findings/*",
        "arn:aws:s3:::<S3_BUCKET_NAME>/hotspot-tests/reviews/*"
      ]
    }
  ]
}
