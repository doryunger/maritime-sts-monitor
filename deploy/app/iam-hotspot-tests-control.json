{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListHotspotTestFindings",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<S3_BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "hotspot-tests/findings/*"
        }
      }
    },
    {
      "Sid": "ReadHotspotTestObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::<S3_BUCKET_NAME>/hotspot-tests/artifacts/*",
        "arn:aws:s3:::<S3_BUCKET_NAME>/hotspot-tests/findings/*",
        "arn:aws:s3:::<S3_BUCKET_NAME>/hotspot-tests/reviews/*"
      ]
    }
  ]
}
